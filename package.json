{
  "name": "sparrow-account",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n API,ADMIN -c blue,green \"npm:api:dev\" \"npm:admin:dev\"",
    "predev": "npm run setup:local",
    "api:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply sparrow-account-db --local",
    "migrate:remote": "wrangler d1 migrations apply sparrow-account-db --remote",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@serenity-kit/opaque": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.6",
    "wrangler": "^4.166.0"
  }
}
