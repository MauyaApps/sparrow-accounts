{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparrow-account-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  // nodejs_compat: проверенный режим выполнения OPAQUE WASM в Workers.
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparrow-account-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AUTH_STATE", "class_name": "AuthState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthState"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
  // Секреты задаются через .dev.vars локально; в Cloudflare — через wrangler secret put.
}
